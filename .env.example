# Bearer token for API authentication (REQUIRED)
# Generate a secure token with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Then paste it here:
BEARER_TOKEN=

# Log file path (defaults to temp_monitor.log in current directory)
# Can be absolute or relative path
LOG_FILE=temp_monitor.log

# ===== CLOUDFLARED TUNNEL =====
# Cloudflare Tunnel token from Zero Trust dashboard
# Used by docker-compose cloudflared service
CLOUDFLARED_TOKEN=

# ===== WEBHOOK CONFIGURATION =====
# Slack incoming webhook URL for alerts and notifications (optional - required for webhook features)
# Get this from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Enable or disable webhook notifications (default: true)
WEBHOOK_ENABLED=true

# Webhook retry configuration
WEBHOOK_RETRY_COUNT=3
WEBHOOK_RETRY_DELAY=5
WEBHOOK_TIMEOUT=10

# Minimum seconds between repeating the same alert type (default: 900 = 15 minutes)
ALERT_COOLDOWN_SECONDS=900

# ===== ALERT THRESHOLDS =====
# Temperature thresholds in Celsius.
# Default: 15°C (59°F) min, 32°C (90°F) max
ALERT_TEMP_MIN_C=15.0
ALERT_TEMP_MAX_C=32.0

# Humidity thresholds in percentage.
# Default: 20% min, 70% max
ALERT_HUMIDITY_MIN=20.0
ALERT_HUMIDITY_MAX=70.0

# NOTE: an unset or empty value for any of the four thresholds above uses the
# documented default shown next to it. A value that isn't a parseable number
# raises at startup naming the offending variable, rather than being silently
# ignored.

# ===== PERIODIC STATUS UPDATES =====
# Enable periodic status updates via webhook (default: false)
# Set to 'true' to receive regular status reports at specified intervals
STATUS_UPDATE_ENABLED=false

# Interval for status updates in seconds (default: 3600 = 1 hour)
# Common values:
#   - 1800 = 30 minutes
#   - 3600 = 1 hour (recommended)
#   - 7200 = 2 hours
#   - 14400 = 4 hours
#   - 86400 = 24 hours (daily)
# Note: Cannot be less than 60 seconds (sampling interval)
STATUS_UPDATE_INTERVAL=3600

# Send status update immediately on startup (default: false)
# Useful for confirming service is running after deployment
STATUS_UPDATE_ON_STARTUP=false

# ===== SENSOR SOURCE =====
# Load the fabricated-data stub (mock_sense_hat.py) instead of the real Sense
# HAT hardware. Default: unset/off.
# NEVER set this in production. This stub once shadowed the real sense-hat
# package on sys.path and made the app silently report a constant fake
# 25.0 degC — only enable it for local development without hardware.
USE_MOCK_SENSOR=

# ===== TEMPERATURE CALIBRATION =====
# Empirical constants used to convert the raw sensor reading into an ambient
# temperature/humidity estimate. See CLAUDE.md "Temperature Calibration" for
# how to derive these from paired reference-thermometer samples.

# CPU-heat coupling coefficient (default: 0.7)
TEMP_CPU_FACTOR=0.7

# Empirical temperature offset in degrees F (default: -13.5)
TEMP_OFFSET_F=-13.5

# Empirical humidity offset in percentage points (default: 4.0)
HUMIDITY_OFFSET=4.0
